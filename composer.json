{
    "name": "perdi/portfolio-laravel",
    "type": "project",
    "description": "Portofolio Web Perdi (NPM: 24312212) — S1 Informatika berbasis Laravel, PHP OOP Class, dan Tailwind CSS",
    "keywords": [
        "laravel",
        "portfolio",
        "tailwindcss",
        "perdi",
        "informatika",
        "oop-class"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "laravel/framework": "^9.52"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "policy": {
        "advisories": {
            "block": false
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    }
}
